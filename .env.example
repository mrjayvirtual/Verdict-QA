# Verdict QA - environment template
# Copy to .env.local and fill in. Never commit real values.
# Only variables prefixed VITE_ are exposed to the browser. They must never hold secrets.

# --- Server only ---------------------------------------------------
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/verdict

# Long random string used to sign sessions (generate with: openssl rand -hex 32)
JWT_SECRET=

# Allowed web origin for CORS
CORS_ORIGIN=http://localhost:5173

# AI judges. If AI_API_KEY is empty, Verdict reports AI evaluation as
# unavailable. It never simulates results.
AI_PROVIDER=
AI_API_KEY=

# Optional: enables repository evaluation
GITHUB_TOKEN=

# --- Browser (public, no secrets) -----------------------------------
VITE_API_URL=http://localhost:3001
